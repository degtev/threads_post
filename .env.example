# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id

# Subreddits list (format: name:minScore or just name)
SUBREDDITS=technology:1000,programming:1000,ChatGPT:1000,MachineLearning:500,artificial:500,LocalLLaMA:500
REDDIT_DELAY_MS=4000

# AnyModel (OpenAI-compatible)
ANYMODEL_API_KEY=your_anymodel_api_key
ANYMODEL_MODEL=am/deepseek-v4-flash

# Threads (Meta)
THREADS_ACCESS_TOKEN=your_long_lived_token
THREADS_USER_ID=your_threads_user_id
THREADS_APP_SECRET=your_app_secret

# Scheduler (cron expression)
CRON_SCHEDULE=0 */3 * * *
